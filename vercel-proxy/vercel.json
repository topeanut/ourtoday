{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/v3/api-docs", "destination": "http://SERVER_IP:8080/v3/api-docs" },
    { "source": "/swagger-ui.html", "destination": "http://SERVER_IP:8080/swagger-ui.html" },
    { "source": "/api/:path+", "destination": "http://SERVER_IP:8080/api/:path+" },
    { "source": "/oauth2/:path+", "destination": "http://SERVER_IP:8080/oauth2/:path+" },
    { "source": "/login/:path+", "destination": "http://SERVER_IP:8080/login/:path+" },
    { "source": "/swagger-ui/:path+", "destination": "http://SERVER_IP:8080/swagger-ui/:path+" },
    { "source": "/v3/api-docs/:path+", "destination": "http://SERVER_IP:8080/v3/api-docs/:path+" }
  ]
}
