# EC2 에서 .env 로 복사 후 값 채우기:  cp .env.example .env
DB_NAME=ourtoday
DB_USERNAME=ourtoday
DB_PASSWORD=change_me_strong_password

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://ourtoday.vercel.app/login/oauth2/code/kakao
# 이미지 저장소 (S3 호환). 운영: Oracle Object Storage
#   STORAGE_ENDPOINT=https://<namespace>.compat.objectstorage.ap-osaka-1.oraclecloud.com
#   STORAGE_REGION=ap-osaka-1
#   ACCESS/SECRET = Oracle 콘솔 > 내 프로필 > 고객 암호 키(Customer Secret Keys)
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=ourtoday-images
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# 프론트 생기면 설정 (비우면 로그인 결과를 JSON 으로 응답)
OAUTH2_SUCCESS_REDIRECT_URI=

# openssl rand -base64 48
JWT_SECRET=
