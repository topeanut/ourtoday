// 오늘의 우리 — Database Schema
// dbdiagram.io에 그대로 붙여넣기

Project our_today {
  database_type: 'PostgreSQL'
  Note: '연인용 3줄 일기 + 아카이빙 앱'
}

// ===== Enums =====
Enum couple_status {
  PENDING
  CONNECTED
  BROKEN
}

Enum emoji_type {
  HEART
  LAUGH
  SURPRISE
  SAD
  FIRE
}

// ===== Tables =====

Table users {
  id uuid [pk]
  kakao_id varchar [unique, not null, note: '카카오 OAuth 식별자']
  nickname varchar [not null]
  profile_image_url varchar
  created_at timestamp [not null, default: `now()`]
}

Table user_settings {
  user_id uuid [pk]
  notify_memory_today boolean [not null, default: true, note: '작년 오늘 알림']
  notify_partner_post boolean [not null, default: true, note: '상대가 글/메모 작성 시 알림']
  updated_at timestamp [not null, default: `now()`]
}

Table couples {
  id uuid [pk]
  invite_code varchar [unique, note: '6~8자리, 두 번째 멤버 합류 시 NULL 처리']
  invite_code_expires_at timestamp
  started_at date [note: '두 번째 멤버 합류 시점에 세팅, 마이페이지에서 수정 가능']
  status couple_status [not null, default: 'PENDING']
  created_at timestamp [not null, default: `now()`]

  Indexes {
    invite_code
  }
}

Table couple_members {
  couple_id uuid [not null]
  user_id uuid [not null]
  joined_at timestamp [not null, default: `now()`]

  Indexes {
    (couple_id, user_id) [pk]
    user_id [note: '활성 커플 1개 제약은 애플리케이션 레벨에서 처리']
  }
}

Table posts {
  id uuid [pk]
  couple_id uuid [not null]
  author_id uuid [not null]
  content varchar(300) [not null, note: '3줄 일기 본문']
  posted_date date [not null, note: '작년 오늘 조회의 핵심']
  place_lat double [note: '위치 첨부(선택). place_lat/lng/name 은 함께 있거나 함께 null']
  place_lng double
  place_name varchar(100)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Indexes {
    (couple_id, posted_date) [name: 'idx_posts_couple_date']
    (couple_id, author_id, created_at) [name: 'idx_posts_couple_author']
  }
}

Table post_images {
  id uuid [pk]
  post_id uuid [not null]
  image_url varchar [not null, note: 'S3 객체 URL 또는 key']
  display_order int [not null, default: 0]
}

Table reactions {
  id uuid [pk]
  post_id uuid [not null]
  user_id uuid [not null]
  emoji_type emoji_type [not null]
  created_at timestamp [not null, default: `now()`]

  Indexes {
    (post_id, user_id, emoji_type) [unique]
    post_id
  }
}

Table comments {
  id uuid [pk]
  post_id uuid [not null]
  author_id uuid [not null]
  content varchar(200) [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Indexes {
    (post_id, created_at)
  }
}

Table calendar_memos {
  id uuid [pk]
  couple_id uuid [not null]
  author_id uuid [not null]
  date date [not null, note: '메모가 표시될 날짜']
  title varchar(50) [not null]
  description text
  color varchar [note: '예: #FFB6C1']
  place_lat double [note: '위치 첨부(선택). place_lat/lng/name 은 함께 있거나 함께 null']
  place_lng double
  place_name varchar(100)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Indexes {
    (couple_id, date) [name: 'idx_memos_couple_date']
  }
}

Table bucket_items {
  id uuid [pk]
  couple_id uuid [not null]
  created_by uuid [not null]
  title varchar [not null]
  description text
  target_date date
  is_completed boolean [not null, default: false]
  completed_post_id uuid [note: '완료 시 어떤 게시글에서 달성했는지 연결']
  created_at timestamp [not null, default: `now()`]
  completed_at timestamp
}

Table location_shares {
  user_id uuid [pk, note: '사용자별 위치 공유 현재 상태']
  enabled boolean [not null, default: false]
  updated_at timestamp [not null, default: `now()`]
}

Table location_share_events {
  id uuid [pk]
  user_id uuid [not null]
  enabled boolean [not null, note: '실제 상태 변경마다 1행 append']
  at timestamp [not null]

  Indexes {
    (user_id, at) [name: 'idx_location_share_events_user_at']
  }
}

Table location_points {
  id uuid [pk]
  user_id uuid [not null]
  lat double [not null]
  lng double [not null]
  accuracy double [note: 'nullable (m)']
  captured_at timestamp [not null]
  source varchar(20) [not null, note: 'COARSE | PRECISE']
  created_at timestamp [not null]

  Indexes {
    (user_id, captured_at) [name: 'idx_location_points_user_captured']
  }
}

Table location_daily {
  id uuid [pk]
  user_id uuid [not null]
  date date [not null, note: 'KST 기준 일자']
  point_count int [not null]
  first_at timestamp [not null]
  last_at timestamp [not null]
  polyline text [not null, note: 'Douglas-Peucker 단순화 "lat,lng;lat,lng"']

  Indexes {
    (user_id, date) [unique, name: 'uk_location_daily_user_date']
  }
}

// ===== References =====

Ref: user_settings.user_id > users.id

Ref: couple_members.couple_id > couples.id
Ref: couple_members.user_id > users.id

Ref: posts.couple_id > couples.id
Ref: posts.author_id > users.id

Ref: post_images.post_id > posts.id

Ref: reactions.post_id > posts.id
Ref: reactions.user_id > users.id

Ref: comments.post_id > posts.id
Ref: comments.author_id > users.id

Ref: calendar_memos.couple_id > couples.id
Ref: calendar_memos.author_id > users.id

Ref: bucket_items.couple_id > couples.id
Ref: bucket_items.created_by > users.id
Ref: bucket_items.completed_post_id > posts.id

Ref: location_shares.user_id > users.id
Table location_precise_requests {
  id uuid [pk]
  requester_id uuid [not null]
  target_id uuid [not null]
  expires_at timestamp [not null, note: '지나면 비활성 (생성 +3분, 재요청 시 연장)']
  created_at timestamp [not null]

  Indexes {
    (target_id, expires_at) [name: 'idx_precise_requests_target_expires']
    (requester_id, target_id) [name: 'idx_precise_requests_requester_target']
  }
}

Table location_access_log {
  id uuid [pk]
  viewer_id uuid [not null]
  target_id uuid [not null]
  kind varchar(10) [not null, note: 'COARSE | PRECISE']
  started_at timestamp [not null, note: '정밀 요청 성공마다 1행 append']

  Indexes {
    (target_id, started_at) [name: 'idx_location_access_log_target_started']
  }
}

Ref: location_share_events.user_id > users.id
Ref: location_points.user_id > users.id
Ref: location_daily.user_id > users.id
Ref: location_precise_requests.requester_id > users.id
Ref: location_precise_requests.target_id > users.id
Ref: location_access_log.viewer_id > users.id
Ref: location_access_log.target_id > users.id
