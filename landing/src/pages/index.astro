---
import Base from "../layouts/Base.astro";
import { SITE_URL, WEB_APP_URL, PLAY_URL, PLAY_READY } from "../config";

const features = [
  { ico: "📝", title: "세 줄 일기 + 사진 4장", desc: "길게 쓰지 않아도 괜찮아요. 오늘 있었던 일을 세 줄로, 사진은 최대 4장까지." },
  { ico: "❤️", title: "댓글 대신 반응 이모지", desc: "답장 부담 없이 하트·웃음·불꽃으로 마음만 전해요." },
  { ico: "✨", title: "작년 오늘", desc: "1년 전, 2년 전 같은 날의 기록을 꺼내 보여 줘요. 시간이 지날수록 더 소중해져요." },
  { ico: "✅", title: "데이트 버킷리스트", desc: "함께 하고 싶은 것을 적고, 이룬 날의 기록과 함께 달성으로 남겨요." },
  { ico: "🗓️", title: "커플 캘린더", desc: "기념일·여행·약속을 둘이 함께 보는 캘린더에 메모해요." },
  { ico: "📊", title: "우리의 기록 통계", desc: "사귄 지 며칠째인지, 누가 며칠 연속 기록했는지 한눈에." },
  { ico: "🔒", title: "둘만의 공간", desc: "초대코드로 연결된 두 사람만 볼 수 있어요. 언제든 데이터 내보내기와 탈퇴가 가능해요." },
];

const faqs = [
  { q: "무료인가요?", a: "네, 모든 기능을 무료로 쓸 수 있어요." },
  { q: "둘 다 앱을 깔아야 하나요?", a: "아니요. 한 사람은 앱, 다른 한 사람은 웹으로 써도 같은 기록을 함께 볼 수 있어요." },
  { q: "헤어지면 기록은 어떻게 되나요?", a: "커플 연결을 해제하면 두 사람 모두 함께 쓴 기록을 더 이상 볼 수 없어요. 간직하고 싶다면 해제 전에 마이페이지에서 데이터를 내보내 주세요." },
  { q: "탈퇴하면 어떻게 되나요?", a: "내가 쓴 기록·사진·반응·댓글·메모와 계정이 바로 삭제돼요." },
  { q: "아이폰에서도 쓸 수 있나요?", a: "iOS 앱은 준비 중이에요. 그전까지는 아이폰 브라우저에서 웹으로 똑같이 쓸 수 있어요." },
  { q: "사진과 기록은 안전한가요?", a: "모든 기록은 비공개로 저장되고, 사진은 로그인한 두 사람에게만 1시간짜리 임시 링크로 보여져요." },
];

const shots = [
  { src: "/screens/1.jpg", caption: "오늘의 기록", alt: "오늘의 우리 홈 화면 — 커플이 쓴 세 줄 일기 목록" },
  { src: "/screens/2.jpg", caption: "사진과 반응", alt: "사진 두 장이 붙은 기록과 하트·불꽃 반응" },
  { src: "/screens/3.jpg", caption: "버킷리스트", alt: "데이트 버킷리스트 화면 — 함께 이룬 항목과 진행률" },
  { src: "/screens/4.jpg", caption: "커플 캘린더", alt: "커플 캘린더 화면 — 기념일과 일정 메모" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "MobileApplication",
    name: "오늘의 우리",
    operatingSystem: "ANDROID",
    applicationCategory: "LifestyleApplication",
    url: SITE_URL,
    description: "세 줄이면 충분한 커플 일기 앱. 작년 오늘, 데이트 버킷리스트, 커플 캘린더.",
    offers: { "@type": "Offer", price: "0", priceCurrency: "KRW" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---
<Base
  title="오늘의 우리 — 세 줄이면 충분한 커플 일기 앱"
  description="연인과 하루를 세 줄로 기록하는 커플 다이어리 앱. 작년 오늘 추억, 데이트 버킷리스트, 커플 캘린더까지 무료로."
  path="/"
  jsonLd={jsonLd}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <div>
        <span class="eyebrow">커플 일기 앱</span>
        <h1 id="hero-title">세 줄이면 충분한<br /><em>우리 둘의 일기</em></h1>
        <p class="lead">부담 없이 기록하고, 시간이 지나 다시 발견하는 추억.<br />연인과 함께 쓰는 가장 가벼운 다이어리.</p>
        <div class="cta-row">
          {PLAY_READY ? (
            <a class="btn btn-primary" href={PLAY_URL} rel="noopener">
              <span aria-hidden="true">▶</span>
              <span class="stack"><small>다운로드</small>Google Play</span>
            </a>
          ) : (
            <span class="btn btn-disabled" aria-disabled="true">
              <span aria-hidden="true">▶</span>
              <span class="stack"><small>Google Play</small>Android 출시 준비 중</span>
            </span>
          )}
          <a class="btn btn-soft" href={WEB_APP_URL}>웹으로 바로 시작하기</a>
        </div>
        <p class="note">iOS 앱은 준비 중이에요. 아이폰에서는 웹으로 바로 쓸 수 있어요.</p>
      </div>
      <div class="hero-visual">
        <div class="phone">
          <img src="/screens/1.jpg" alt="오늘의 우리 앱 홈 화면" width="1080" height="1920" fetchpriority="high" />
        </div>
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="features-title">
    <div class="wrap">
      <h2 id="features-title">길게 쓰지 않아도, 매일 쓰지 않아도</h2>
      <p class="desc">작성은 선택. 쌓일수록 가치가 커지는 커플 기록 앱이에요.</p>
      <div class="grid cols">
        {features.map((f) => (
          <article class="card">
            <div class="ico" aria-hidden="true">{f.ico}</div>
            <h3>{f.title}</h3>
            <p>{f.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="screens-title">
    <div class="wrap">
      <h2 id="screens-title">화면 미리보기</h2>
      <p class="desc">모바일은 물론 PC에서도 똑같이 쓸 수 있어요.</p>
      <div class="shots">
        {shots.map((s) => (
          <figure>
            <div class="phone">
              <img src={s.src} alt={s.alt} width="1080" height="1920" loading="lazy" decoding="async" />
            </div>
            <figcaption>{s.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="start-title">
    <div class="wrap">
      <h2 id="start-title">이렇게 시작해요</h2>
      <p class="desc">1분이면 둘만의 일기장이 열려요.</p>
      <ol class="steps">
        <li><div><strong>카카오·Apple로 로그인</strong><span>회원 식별값만 받아요. 프로필·이메일은 받지 않아요.</span></div></li>
        <li><div><strong>초대코드로 연결</strong><span>한 사람이 코드를 만들고, 상대가 입력하면 끝.</span></div></li>
        <li><div><strong>오늘, 세 줄</strong><span>사진 한 장과 세 줄이면 오늘의 기록 완성.</span></div></li>
      </ol>
    </div>
  </section>

  <section class="block faq" aria-labelledby="faq-title">
    <div class="wrap narrow">
      <h2 id="faq-title">자주 묻는 질문</h2>
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="block" aria-labelledby="final-title">
    <div class="wrap">
      <div class="final">
        <h2 id="final-title">오늘의 우리를 남겨 보세요</h2>
        <p class="note" style="margin:0 0 20px">기념일 디데이부터 1년 뒤의 추억까지, 둘만의 기록이 쌓여요.</p>
        <div class="cta-row">
          {PLAY_READY ? (
            <a class="btn btn-primary" href={PLAY_URL} rel="noopener">Google Play에서 받기</a>
          ) : (
            <span class="btn btn-disabled" aria-disabled="true">Android 출시 준비 중</span>
          )}
          <a class="btn btn-soft" href={WEB_APP_URL}>웹으로 바로 시작하기</a>
        </div>
      </div>
    </div>
  </section>
</Base>
